{
  "name": "dsh-bookmarks-desk",
  "version": "0.1.0",
  "description": "把浏览器收藏夹接进 DeepSeek Harness：卡片书架 + 分类树 + 搜索 + 卡片详情。 · Browser bookmarks as a shelf inside DeepSeek Harness.",
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./panel/*": "./panel/*",
    "./package.json": "./package.json"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "panel/index.html",
    "locale/*.json",
    "icon.svg",
    "examples",
    "scripts/preview.mjs",
    "scripts/classify.mjs",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": { "platform": "web", "immediately": true }
  },
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "dsh-plugin",
    "bookmarks",
    "chrome",
    "收藏夹"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hanxiaoxin0715/dsh-bookmarks-desk.git"
  },
  "homepage": "https://github.com/hanxiaoxin0715/dsh-bookmarks-desk#readme",
  "bugs": {
    "url": "https://github.com/hanxiaoxin0715/dsh-bookmarks-desk/issues"
  },
  "scripts": {
    "check": "node --check index.js && node --check client.js"
  }
}
